<%- include('../partials/header') %>

<div class="container mt-4">
  <h3 class="mb-4">Reports Dashboard</h3>

  <div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2-4">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="text-muted small">Today's Sales</div>
          <div class="fs-4 fw-bold">₹<%= Number(todaySales).toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2-4">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="text-muted small">This Month's Sales</div>
          <div class="fs-4 fw-bold">₹<%= Number(monthSales).toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2-4">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="text-muted small">GST Collected (Month)</div>
          <div class="fs-4 fw-bold">₹<%= Number(monthGst).toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-2-4">
      <div class="card text-center h-100 <%= lowStockCount > 0 ? 'border-warning' : '' %>">
        <div class="card-body">
          <div class="text-muted small">Low Stock Alerts</div>
          <div class="fs-4 fw-bold <%= lowStockCount > 0 ? 'text-warning' : '' %>"><%= lowStockCount %></div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-2-4">
      <div class="card text-center h-100 <%= nearExpiryCount > 0 ? 'border-danger' : '' %>">
        <div class="card-body">
          <div class="text-muted small">Near-Expiry Alerts</div>
          <div class="fs-4 fw-bold <%= nearExpiryCount > 0 ? 'text-danger' : '' %>"><%= nearExpiryCount %></div>
        </div>
      </div>
    </div>
  </div>

  <h5 class="mb-3">Top 5 Selling Medicines</h5>
  <table class="table table-bordered">
    <thead class="table-light">
      <tr>
        <th>#</th>
        <th>Medicine</th>
        <th class="text-end">Quantity Sold</th>
      </tr>
    </thead>
    <tbody>
      <% if (topMedicines.length === 0) { %>
        <tr><td colspan="3" class="text-center text-muted">No sales data yet</td></tr>
      <% } else { %>
        <% topMedicines.forEach(function(med, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= med.name %></td>
            <td class="text-end"><%= med.quantity_sold %></td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Bootstrap's grid tops out at 6 columns per row by default (col-lg-2 = 6 cols);
     with 5 stat cards, col-lg-2-4 below gives 5 equal columns instead of an
     uneven 6th gap. No new dependency — just a small custom class. -->
<style>
  @media (min-width: 992px) {
    .col-lg-2-4 {
      flex: 0 0 20%;
      max-width: 20%;
    }
  }
</style>

<%- include('../partials/footer') %>