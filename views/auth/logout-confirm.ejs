<%- include('../partials/header') %>

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 60vh;">
  <div class="text-warning mb-3" style="font-size: 3rem;">
    <i class="bi bi-exclamation-triangle-fill"></i>
  </div>
  <h2 class="mb-2">Are you sure you want to log out?</h2>
  <p class="text-muted mb-4">You'll need to sign in again to access the dashboard.</p>

  <div class="d-flex gap-2">
    <form action="/logout" method="POST" class="m-0">
      <button type="submit" class="btn btn-danger px-4">
        <i class="bi bi-box-arrow-right me-1"></i> Yes, log out
      </button>
    </form>
    <a href="/dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
  </div>
</div>

<%- include('../partials/footer') %>