<%- include('../partials/header', { title: 'Purchase Details' }) %>

<div class="container-fluid mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Purchase Details</h3>
    <a href="/purchase" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Purchases
    </a>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-4"><strong>Supplier:</strong> <%= purchase.supplier_name %></div>
        <div class="col-md-4"><strong>Date:</strong> <%= new Date(purchase.purchase_date || purchase.date).toLocaleDateString('en-IN') %></div>
        <div class="col-md-4"><strong>Total:</strong> ₹<%= Number(purchase.total_amount).toFixed(2) %></div>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle bg-white">
      <thead class="table-dark">
        <tr>
          <th>Medicine</th>
          <th>Batch Number</th>
          <th>Quantity</th>
          <th class="text-end">Price</th>
        </tr>
      </thead>
      <tbody>
        <% if (items && items.length > 0) { %>
          <% items.forEach(function(item) { %>
            <tr>
              <td><%= item.medicine_name %></td>
              <td><%= item.batch_number %></td>
              <td><%= item.quantity %></td>
              <td class="text-end">₹<%= Number(item.price).toFixed(2) %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">No items found for this purchase.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

<%- include('../partials/footer') %>