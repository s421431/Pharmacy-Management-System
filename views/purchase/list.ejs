<%- include('../partials/header', { title: 'Purchases' }) %>

<div class="container-fluid mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Purchases</h3>
    <% if (user && user.role === 'admin') { %>
      <a href="/purchase/add" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Purchase
      </a>
    <% } %>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle bg-white">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Supplier</th>
          <th>Purchase Date</th>
          <th class="text-end">Total Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if (purchases && purchases.length > 0) { %>
          <% purchases.forEach(function(p, index) { %>
            <tr onclick="window.location='/purchase/<%= p.id %>'" style="cursor:pointer;">
              <td><%= index + 1 %></td>
              <td><%= p.supplier_name %></td>
              <td><%= new Date(p.purchase_date).toLocaleDateString('en-IN') %></td>
              <td class="text-end">₹<%= Number(p.total_amount).toFixed(2) %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center text-muted py-4">No purchases recorded yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

<%- include('../partials/footer') %>