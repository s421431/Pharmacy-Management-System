<%- include('partials/header', { title: 'Something went wrong' }) %>

<div class="container-fluid mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
      <h3 class="mt-3 mb-2">Something went wrong</h3>
      <p class="text-muted mb-4">
        <%= typeof message !== 'undefined' && message ? message : 'An unexpected error occurred. Please try again.' %>
      </p>
      <a href="/dashboard" class="btn btn-primary">
        <i class="bi bi-house-door"></i> Go back to Dashboard
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
