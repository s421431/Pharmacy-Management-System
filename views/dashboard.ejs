        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Bills Today</h6>
          <p class="card-text fs-4 mb-0">--</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Reports Ready</h6>
          <p class="card-text fs-4 mb-0">--</p>
        </div>
      </div>
    </div>
  </div>
</div>

