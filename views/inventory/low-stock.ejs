<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %><title>Low Stock</title></head>
<body>
<%- include('../partials/navbar') %>
<div class="container mt-4">
  <h1>Low Stock (&lt; 10 units)</h1>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Unit</th><th>Total Qty</th></tr></thead>
    <tbody>
      <% medicines.forEach(m => { %><tr><td><%= m.name %></td><td><%= m.unit %></td><td class="text-danger fw-bold"><%= m.total_quantity %></td></tr><% }) %>
      <% if (medicines.length === 0) { %><tr><td colspan="3" class="text-center text-muted">Nothing low on stock.</td></tr><% } %>
    </tbody>
  </table>
  <a href="/inventory">Back to Inventory</a>
</div>
</body>
</html>