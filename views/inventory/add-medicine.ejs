<%- include('../partials/header', { title: 'Add Medicine' }) %>

<div class="container mt-4" style="max-width: 600px;">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Add Medicine</h3>
    <a href="/inventory" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left"></i> Back to Inventory
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="/inventory/add" class="needs-validation" novalidate id="addMedicineForm">

        <div class="mb-3">
          <label for="name" class="form-label">Medicine Name <span class="text-danger">*</span></label>
          <input
            type="text"
            class="form-control"
            id="name"
            name="name"
            required
            placeholder="e.g. Paracetamol 500mg"
          >
          <div class="invalid-feedback">Please enter the medicine name.</div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category <span class="text-danger">*</span></label>
          <input
            type="text"
            class="form-control"
            id="category"
            name="category"
            required
            placeholder="e.g. Analgesic, Antibiotic"
          >
          <div class="invalid-feedback">Please enter a category.</div>
        </div>

        <div class="mb-3">
          <label for="gst_percent" class="form-label">GST % <span class="text-danger">*</span></label>
          <select class="form-select" id="gst_percent" name="gst_percent" required>
            <option value="" disabled selected>Select GST slab</option>
            <option value="5">5%</option>
            <option value="12">12%</option>
            <option value="18">18%</option>
          </select>
          <div class="invalid-feedback">Please select a GST slab.</div>
        </div>

        <div class="mb-3">
          <label for="unit" class="form-label">Unit <span class="text-danger">*</span></label>
          <input
            type="text"
            class="form-control"
            id="unit"
            name="unit"
            required
            placeholder="e.g. Strip, Bottle, Box"
          >
          <div class="invalid-feedback">Please enter a unit.</div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <a href="/inventory" class="btn btn-outline-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Save Medicine
          </button>
        </div>

      </form>
    </div>
  </div>

</div>

<script>
  (function () {
    var form = document.getElementById('addMedicineForm');
    form.addEventListener('submit', function (event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  })();
</script>

<%- include('../partials/footer') %>
